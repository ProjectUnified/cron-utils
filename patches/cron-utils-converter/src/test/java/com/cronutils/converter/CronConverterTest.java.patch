+	/**
+	 * St. John's switches between NST (UTC-3:30) and NDT (UTC-2:30), so a
+	 * hard-coded expectation only holds half the year. Compute the UTC wall
+	 * time for today, matching the converter's Calendar-based offset.
+	 */
+	private static String stJohns(int minute, int hour) {
+		ZonedDateTime utc = ZonedDateTime.now(ZoneId.of("America/St_Johns"))
+				.withHour(hour).withMinute(minute).withSecond(0).withNano(0)
+				.withZoneSameInstant(ZoneOffset.UTC);
+		return utc.getMinute() + " " + utc.getHour() + " * * ?";
+	}
